# Optional. You can do all of this in the dashboard (AI core tab) instead.
# Default brain if you never open the AI core tab: Ollama on this PC (free, no account).
JARVIS_PROVIDER=ollama
JARVIS_BASE_URL=http://127.0.0.1:11434
JARVIS_MODEL=qwen2.5:7b
JARVIS_API_KEY=

# Optional free vision model so JARVIS can SEE the screen (run: ollama pull qwen2.5vl:7b)
JARVIS_VISION_MODEL=

# Longest answer in tokens (short answers are faster and read aloud better)
JARVIS_MAX_TOKENS=350
