# Optional. You can configure all AI brains in the dashboard (AI core tab) instead.
JARVIS_PROVIDER=ollama
JARVIS_BASE_URL=http://127.0.0.1:11434
JARVIS_MODEL=qwen2.5:7b
JARVIS_API_KEY=

# Optional free vision model so JARVIS can SEE the screen (run: ollama pull qwen2.5vl:7b)
JARVIS_VISION_MODEL=

# Voice settings (Paul Bettany British RP neural voice + Kurdish Sorani support)
JARVIS_VOICE_EN=en-GB-RyanNeural
JARVIS_VOICE_KU=ar-IQ-BasselNeural
JARVIS_VOICE_PITCH=-4Hz
JARVIS_VOICE_RATE=+5%

# Max tokens for standard and coding responses
JARVIS_MAX_TOKENS=2048
JARVIS_MAX_CODING_TOKENS=4096
